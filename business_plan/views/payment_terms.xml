<odoo>
    <data>
        <record id="payment_terms_view_list" model="ir.ui.view">
            <field name="name">payment.terms.view.list</field>
            <field name="model">payment.terms</field>
            <field name="arch" type="xml">
                <list>
                    <field name='name'/>
                </list>
            </field>
        </record>

        <record id="view_payment_terms_form" model="ir.ui.view">
            <field name="name">payment.terms.form</field>
            <field name="model">payment.terms</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" string="Nom"/>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>