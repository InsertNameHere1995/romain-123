<odoo>
    <data>
        <record id="founder_view_list" model="ir.ui.view">
            <field name="name">founder.view.list</field>
            <field name="model">founder</field>
            <field name="arch" type="xml">
                <list>
                    <field name='founder_name'/>
                </list>
            </field>
        </record>

        <record id="view_founder_form" model="ir.ui.view">
            <field name="name">founder.form</field>
            <field name="model">founder</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="founder_name" string="Nom"/>
                        <field name="business_project_id"/>
                        <field name="share_capital"/>
                        <field name="share_number"/>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>