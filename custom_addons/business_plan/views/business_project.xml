<odoo>
    <data>
        <record id="view_business_project_form" model="ir.ui.view">
            <field name="name">business.project.form</field>
            <field name="model">business.project</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" string="Nom"/>
                        <field name="legal_name"/>
                        <field name="entity_type"/>
                        <field name="first_fiscal_year_start"/>
                        <field name="first_fiscal_year_end"/>
                        <field name="share_capital"/>
                        <field name="currency_id" invisible="1" />
                        <field name="share_number"/>
                        <field name="share_value"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="second_fiscal_year_start" invisible="0"/>
                        <field name="second_fiscal_year_end" invisible="0"/>
                        <field name="third_fiscal_year_start" invisible="0"/>
                        <field name="third_fiscal_year_end" invisible="0"/>
                        <field name="fourth_fiscal_year_start" invisible="0"/>
                        <field name="fourth_fiscal_year_end" invisible="0"/>
                    </group>
                    <notebook>
                        <page name="Founders">
                            <field name="founder_ids">
                                <list editable="bottom" multi_edit="1" open_form_view="True">
                                    <field name="id"/>
                                    <field name="is_founder"/>
                                    <field name="business_project_id"/>
                                    <field name="share_capital"/>
                                    <field name="share_number"/>
                                </list>
                            </field>
                        </page>
                        <page name="Périodes">
                            <field name="period_ids">
                                <list editable="bottom" multi_edit="1" open_form_view="True" context="{'group_by':'start_date:month'}">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="invoiced_income_amount_no_vat"/>
                                    <field name="invoiced_income_ids"/>
                                    <field name="cashflow_income_ids"/>
                                    <field name="cashflow_income_amount_with_vat"/>
                                    <field name="invoiced_charges_ids"/>
                                </list>
                            </field>
                        </page>
                        <page name="Revenus">
                            <field name="forecast_income_ids">
                                <list editable="bottom" multi_edit="1" open_form_view="True">
                                    <field name="id"/>
                                    <field name="amount_no_vat"/>
                                    <field name="is_recurring"/>
                                    <field name="end_date"/>
                                    <field name="account_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="Charges">
                            <field name="charges_ids">
                                <list editable="bottom" multi_edit="1" open_form_view="True">
                                    <field name="id"/>
                                    <field name="amount_no_vat"/>
                                    <field name="is_recurring"/>
                                    <field name="end_date"/>
                                    <field name="account_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="Emprunts">
                            <field name="forecast_loan_ids">
                                <list editable="bottom" multi_edit="1" open_form_view="True">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="action_business_project" model="ir.actions.act_window">
            <field name="name">Projet d'entreprise</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">business.project</field>
            <field name="view_mode">list,form,graph</field>
        </record>
        <menuitem id="menu_project_root"
                  name="Projects d'entreprise"
                  action="action_business_project"
                  sequence="10"/>

        <record id="business_project_view_list" model="ir.ui.view">
            <field name="name">business.project.view.list</field>
            <field name="model">business.project</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name='name'/>
                    <field name="share_capital"/>
                    <field name="share_number"/>
                    <field name="share_value"/>
                </list>
            </field>
        </record>
    </data>
</odoo>