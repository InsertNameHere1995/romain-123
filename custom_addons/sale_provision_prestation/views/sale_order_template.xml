<odoo>
    <record id="sale_order_template_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
        <!--  Ajouter le champ après le champ 'name'  -->
        <xpath expr="//field[@name='name']" position="after">
            <field name="is_provision"/>
            <field name="is_prestation"/>
            <field name="sequence_id" options="{'no_create': True, 'no_open': True}"/>
        </xpath>
        </field>
    </record>
</odoo>